{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zannel12/agent-recall/protocol/v1/error.schema.json",
  "title": "Cited Vault Recall protocol error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "message", "next_step", "retryable"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "message": {"type": "string", "minLength": 1},
    "next_step": {
      "type": "string",
      "enum": ["CHECK_ARGUMENTS", "CHECK_EXPLICIT_VAULT", "SEARCH_AGAIN"]
    },
    "retryable": {"type": "boolean"}
  }
}
